# ── Secrets — never commit real env files ────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
!.env.example
secrets/
# Root scratch only — anchored so app/api/n8n (real source) stays tracked.
/n8n/
# pasted n8n workflow exports (contain Green API tokens / prompts)
/SDR*.json
/*-workflow.json
# Bot-template tenant params — real secrets/PII values (the committed template is
# tokenized + secret-free; these *.params.local.json hold the real substitutions).
templates/**/*.params.local.json
*.params.local.json

# ── Node / Next.js ───────────────────────────────────────────────────────────
node_modules/
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# ── Logs / misc ──────────────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.DS_Store
.vercel
coverage/

# ── Research artifacts (large, regenerable) ──────────────────────────────────
docs/ARCHITECTURE.research.json

.vercel
.env*
