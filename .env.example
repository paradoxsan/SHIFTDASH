# ───────────────────────────────────────────────────────────────────────────
#  BOT DASHBOARD — environment variables (TEMPLATE — placeholders only)
#  Real values go in .env.local (git-ignored). Set the same keys in Vercel.
#  EVERYTHING here is SERVER-ONLY. None are NEXT_PUBLIC_* — secrets must never
#  reach the browser. The client talks only to our own /api route handlers.
# ───────────────────────────────────────────────────────────────────────────

# ── Supabase Management API (the "discover everything" key) ──────────────────
# One Personal Access Token discovers ALL your projects + reveals their keys.
# Create at: https://supabase.com/dashboard/account/tokens
SUPABASE_MANAGEMENT_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: restrict to specific project refs (comma-separated). Empty = all.
SUPABASE_PROJECT_ALLOWLIST=
# Optional: override the Management API base (default https://api.supabase.com).
SUPABASE_API_BASE=

# ── BotOps control-plane (Phase 2) ───────────────────────────────────────────
# Project ref hosting the `botops` schema (tenants/bots/...). Option B = a
# schema inside an existing project. Optional — defaults to the project that
# already holds it. Migrating to a dedicated project later = change this ref.
CONTROL_PLANE_REF=

# ── BotOps secrets KEK (Phase 4) ─────────────────────────────────────────────
# Key-encryption-key for encrypting per-bot data-plane credentials at rest in
# botops.bot_secrets (AES-256-GCM). Base64 of EXACTLY 32 bytes.
# Generate with:  openssl rand -base64 32
# Required only when reading/writing encrypted credentials. Rotating it requires
# re-encrypting stored secrets — keep it stable and backed up.
SECRETS_KEK=

# ── N8N (one instance hosting all customer workflows) ────────────────────────
# Use the HOST ROOT (no /api/v1, no /mcp-server). The app appends /api/v1/...
# Settings → n8n API → Create an API key
N8N_BASE_URL=https://your-instance.example.com
N8N_API_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WHAPI (token per customer/channel) ───────────────────────────────────────
# JSON map of  { "<supabase_project_ref>": "<whapi_channel_token>" }.
WHAPI_BASE_URL=https://gate.whapi.cloud
WHAPI_TOKENS_JSON={"project_ref_a":"WHAPI_TOKEN_A","project_ref_b":"WHAPI_TOKEN_B"}

# ── Auth (login gate for the dashboard) ──────────────────────────────────────
DASHBOARD_PASSWORD=change-me-to-something-strong
AUTH_SECRET=generate-a-random-32char-string-here
# Optional: re-enable email+password login (default OFF — Google-only). Set "true".
ENABLE_PASSWORD_LOGIN=
# (AUTH_BASE_URL — the OAuth redirect origin — is set in the Google OAuth section below.)

# ── Internal Copilot API (WhatsApp Copilot bot → /api/internal/*) ─────────────
# Shared bearer secret the n8n Copilot bot sends. REQUIRED for /api/internal/*.
COPILOT_SECRET=generate-a-random-secret

# ── Monitoring cron (Phase 8) ────────────────────────────────────────────────
# Vercel Cron auto-sends this as `Authorization: Bearer $CRON_SECRET`. Set the
# same value here so /api/cron/monitor rejects anyone else. Sub-daily schedules
# (vercel.json uses */5) require a Vercel Pro plan.
CRON_SECRET=generate-a-random-secret

# ── Green API (SDR / agency WhatsApp sending) ────────────────────────────────
GREEN_API_BASE=https://api.green-api.com
GREEN_API_INSTANCE=
GREEN_API_TOKEN=

# ── Claude ───────────────────────────────────────────────────────────────────
# REQUIRED for the in-app copilot (the Claude panel, ⌘K). Also powers the
# NL-query box and the daily digest. Without it the copilot returns 503 and the
# other two are inert. Get one at console.anthropic.com → API keys.
ANTHROPIC_API_KEY=

# ── Google Sheets (agency CRM source of truth) ───────────────────────────────
# Full service-account key JSON on one line; share the sheet with its email.
GOOGLE_SERVICE_ACCOUNT_JSON=
AGENCY_SHEET_ID=

# ── Morning / Green Invoice (the כסף screen) ─────────────────────────────────
# Morning issues a PAIR — an API key id AND a secret. The id alone authenticates
# nothing, so both are required before any figure appears. Generate them in
# Morning → הגדרות → כללי → ממשק API.
# Optional: without them the money screen renders the contract-side numbers and
# says Morning is not connected, and payment badges read "לא ידוע" (never "שולם").
MORNING_API_KEY_ID=
MORNING_API_SECRET=
# Point at the sandbox while testing: https://sandbox.d.greeninvoice.co.il/api/v1
MORNING_API_BASE=

# ── Google OAuth login (allowlisted emails) ──────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
AUTH_ALLOWED_EMAILS=someone@gmail.com,other@gmail.com
# Optional: force the public origin for the OAuth redirect (else auto-detected)
AUTH_BASE_URL=
